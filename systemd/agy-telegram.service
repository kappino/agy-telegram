[Unit]
Description=agy-telegram - Antigravity Telegram Gateway & Cockpit
After=network.target

[Service]
Type=simple
# Non-privileged user running tmux and Antigravity CLI
# User=ubuntu
# Group=ubuntu
WorkingDirectory=%h
StateDirectory=agy-telegram

Environment="PYTHONUNBUFFERED=1"
# Optional: explicitly point to your config file
# Environment="AGY_TELEGRAM_CONFIG=%h/.config/agy-telegram/config.toml"

# ExecStart path can be adapted based on installation method:
ExecStart=/usr/local/bin/agy-telegram start
# Virtualenv installation example:
# ExecStart=%h/.venv/bin/agy-telegram start

Restart=always
RestartSec=5s

# Process security & sandboxing options
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.gemini/antigravity-cli %h/.config/agy-telegram
RuntimeDirectory=agy-telegram
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
